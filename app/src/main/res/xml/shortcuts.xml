<?xml version="1.0" encoding="utf-8"?>
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:shortcutId="paste_and_download"
        android:enabled="true"
        android:icon="@drawable/ic_logo_splash"
        android:shortcutShortLabel="@string/shortcut_paste_short"
        android:shortcutLongLabel="@string/shortcut_paste_long">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetPackage="com.waheed.universaldownloader"
            android:targetClass="com.waheed.universaldownloader.MainActivity">
            <extra android:name="shortcut_action" android:value="paste_and_download" />
        </intent>
    </shortcut>
    <shortcut
        android:shortcutId="open_library"
        android:enabled="true"
        android:icon="@drawable/ic_logo_splash"
        android:shortcutShortLabel="@string/shortcut_library_short"
        android:shortcutLongLabel="@string/shortcut_library_long">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetPackage="com.waheed.universaldownloader"
            android:targetClass="com.waheed.universaldownloader.MainActivity">
            <extra android:name="shortcut_action" android:value="open_library" />
        </intent>
    </shortcut>
</shortcuts>
